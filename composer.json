{
    "name": "blankkids/thinkphp-ddd",
    "version": "5.0.0",
    "description": "ThinkPHP 5.0 DDD 代码生成工具与基础架构包",
    "type": "composer-plugin",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "blankkids",
            "email": "xjw377352472@yahoo.com",
            "homepage": "https://github.com/blankkids"
        },
        {
            "name": "Dencit",
            "email": "632112883@qq.com",
            "homepage": "https://github.com/Dencit"
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "composer-plugin-api": "^2.0",
        "topthink/framework": "5.0.*"
    },
    "autoload": {
        "psr-4": {
            "Blankkids\\ThinkphpDdd\\": "src/"
        }
    },
    "bin": [
        "bin/thinkex",
        "bin/tool"
    ],
    "extra": {
        "class": "Blankkids\\ThinkphpDdd\\Plugin\\ThinkExPlugin"
    },
    "config": {
        "sort-packages": true
    }
}
